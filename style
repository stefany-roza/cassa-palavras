body {

    font-faamily: Arial, sans-serif;
    text-align: center;
    background: #7949b8;
    margin: 0;
    padding: 20px;
}

header{

    margin-bottom:20px;
}

button{

    padding: 10px 20px;
    font-size: 16px;
    cursor: pointer;
    background: #b197cf;
    color: white;
    border: none;
    border-radius: 500px;
    margin-top: 25px;
}

.container {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
}

.grid{
    display: grid;
    gap: 2px;
    background: #ccc;
}
